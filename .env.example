# KGB_Agent 환경변수 — 키 이름만 기록합니다. 실제 값은 .env.local(Git 제외) 또는 배포 플랫폼 환경변수에 넣으세요.

# development | test | staging | production  (staging 이면 상단에 "테스트 환경" 띠 표시)
APP_ENV=development

# PostgreSQL 연결 문자열 (로컬: docker compose up -d 후 아래 값 그대로 사용 가능)
DATABASE_URL=postgresql://kgb:kgb_dev_pw@localhost:5432/kgb_dev

# Auth.js 서명 키 — 32자 이상 무작위 문자열 (예: openssl rand -base64 32)
AUTH_SECRET=
# 사이트 주소 (초대 링크 생성에 사용). 로컬: http://localhost:3000
AUTH_URL=http://localhost:3000
# 파일 다운로드 서명 URL 키 (Phase 2부터 사용)
FILE_URL_SECRET=

# AI: anthropic | openrouter | mock | none   (mock 은 staging/production 에서 시작 거부, 키가 없으면 none)
AI_PROVIDER=none
# AI 키 — .env.local 또는 배포 플랫폼 환경변수에만. 저장소에 커밋 금지
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# 모델 ID (비우면 기본값: anthropic → claude-fable-5-1, openrouter → anthropic/claude-sonnet-4.5)
LLM_MODEL=
# 생각 깊이 (low·medium·high·xhigh·max, 비우면 high)
LLM_EFFORT=
# AI 비용 원화 환산율
USD_KRW=1400

# 워커 실행 방식: inline(웹 프로세스 안, 개인용 기본) | separate | off
WORKER_MODE=inline
# 파일 저장: local(개발) | db(Postgres, 개인용 배포 기본) | s3
STORAGE_DRIVER=local
# local 저장소 위치(기본 ./storage)
LOCAL_STORAGE_DIR=
UPLOAD_MAX_MB=50

# 최초 관리자 계정 (배포 시작 시 없으면 생성, 있으면 그대로 둠). 비밀번호 10자 이상.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# 데모 데이터 (가상 인물·연락처, is_demo 표시). 데모 계정으로 로그인하려면 SEED_DEMO_PASSWORD 지정.
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# 테스트 전용 DB (pnpm test / pnpm test:e2e)
TEST_DATABASE_URL=postgresql://kgb:kgb_dev_pw@localhost:5432/kgb_test
